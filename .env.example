# Copy to v12/.env and fill in your own values. v12/.env is gitignored.
# Only set the keys for examples you actually plan to run.

# ── APIKey ──────────────────────────────────────────────────────────────
# Used by every example. Tenant API key from the LoginRadius admin console.
LR_API_KEY=

# ── APISecret ───────────────────────────────────────────────────────────
# Server-side only. Required by api-key-secret/, x-loginradius-headers/.
LR_API_SECRET=

# ── AccessToken (user-context) ──────────────────────────────────────────
# Returned by a prior login flow. Required by access-token/.
LR_ACCESS_TOKEN=
LR_OIDC_APP_NAME=

# ── BearerToken ─────────────────────────────────────────────────────────
# Required by bearer-token/.
LR_BEARER_TOKEN=

# ── M2MBearerToken (JWT) ────────────────────────────────────────────────
# Obtained via client.oauthM2M.generateM2MToken(...). Required by m2m-bearer-token/.
LR_M2M_BEARER_TOKEN=

# ── ClientId + ClientSecret (OAuth app) ─────────────────────────────────
# Required by client-id-secret/.
LR_CLIENT_ID=
LR_CLIENT_SECRET=
LR_TARGET_UID=

# ── X-LoginRadius-Api{Key,Secret} (header-only overrides) ───────────────
# Required by x-loginradius-headers/ when header value must differ from query.
LR_X_API_KEY=
LR_X_API_SECRET=

# ── Misc (used by api-key-secret/ and x-loginradius-headers/) ───────────
# Social-provider access token (Facebook/Google/etc.) for token exchange demo.
LR_SOCIAL_TOKEN=

# ── login/ example ──────────────────────────────────────────────────────
LR_EMAIL=
