    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "loginradius-sdk": "file:.."
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
