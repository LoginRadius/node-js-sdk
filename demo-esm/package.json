{
  "name": "loginradius-sdk-demo-esm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript demo for loginradius-sdk@12 (ESM path)",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "npm run build && node --watch dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
