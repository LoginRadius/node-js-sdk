# Copy to .env (gitignored) and fill in values from your LoginRadius dashboard.

LR_API_KEY=
LR_API_SECRET=

# ── Server selection (optional) ─────────────────────────────────────────
# Highest precedence first; leave all unset to use https://api.loginradius.com.
#   LR_BASE_URL       used verbatim (staging / proxy)
#   LR_CUSTOM_DOMAIN  https://{value}
#   LR_DOMAIN         https://{value}.hub.loginradius.com
LR_DOMAIN=
LR_CUSTOM_DOMAIN=
LR_BASE_URL=

# Where email links point back to.
#
# LR_VERIFICATION_URL must address the demo's own verify ROUTE, not the site
# root — LoginRadius appends ?vtoken=... to it, and the handler reads that,
# verifies the account and redirects to / with a banner.
LR_VERIFICATION_URL=http://localhost:3000/api/auth/verify
LR_RESET_PASSWORD_URL=http://localhost:3000/

# The session and MFA cookie names are NOT configurable: they come from
# the shared SDK manifest and are generated into src/routes.generated.ts, so they
# cannot drift between the LoginRadius SDKs.

# Server port.
PORT=3000
